# Copy this file to scripts/.env and fill in your values.
# scripts/.env is gitignored — never commit real API keys.

# Base URL of your OpenAI-compatible API endpoint
OPENAI_BASE_URL=https://api.openai.com/v1

# Your API key
OPENAI_API_KEY=sk-...

# Model to use (gpt-4o-mini is fast and cheap for translation)
OPENAI_MODEL=gpt-4o-mini
