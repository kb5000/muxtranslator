{
  "name": "otranslator",
  "version": "1.7.1",
  "private": true,
  "description": "MuxTranslator browser extension tests",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/lib/utils.js",
      "src/lib/settings.js"
    ]
  }
}
